# SeeMyGD webapp — copy to .env and fill in real values.
# Only VITE_-prefixed variables reach the browser, so never put secrets here.

# Backend origin. Leave empty in production so the app uses relative /api/... URLs
# and works on any custom domain. Set it in dev when the API runs on another port.
VITE_BACKEND_URL=http://localhost:3000

# Public origin of the webapp itself (used for canonical/OG URLs and embed snippets).
VITE_BASE_URL=http://localhost:8000

# Optional: origin of the customer portal, when hosted separately.
VITE_PORTAL_URL=
