# SeeMyGD backend — copy to .env and fill in real values.
# Never commit the filled-in .env.

# --- Server ---
PORT=3000
# Public URL of this deployment (API + frontend are served from one origin).
BACKEND_URL=http://localhost:3000
# Where Square checkout redirects back to. Same origin unless split.
FRONTEND_URL=http://localhost:3000
# Extra CORS / Better Auth origins, comma-separated. Add the tool's public host
# here (e.g. https://app.seemygd.com) plus any host embedding it.
EXTRA_TRUSTED_ORIGINS=

# --- Database: Supabase Postgres ---
# Supabase Dashboard → Project Settings → Database → Connection string.
# DATABASE_URL = "Transaction pooler" (port 6543) — used at runtime.
# DIRECT_URL   = "Direct connection" (port 5432) — used by prisma migrate.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (company logos + hero banners) ---
# Project Settings → API. The service role key is secret — server-side only.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Public bucket that holds branding images. Created in MIGRATION.md step 3.
SUPABASE_BRANDING_BUCKET=branding

# --- Auth (Better Auth) ---
# Random 32+ char string. Generate with: openssl rand -base64 32
# Keep the existing value when migrating, or every user is logged out.
BETTER_AUTH_SECRET=
# Account that always gets super-admin access to /admin.
SUPER_ADMIN_EMAIL=
# Shared secret guarding the admin-only routes.
ADMIN_SECRET=changeme
# Signs the 48h /preview sales links. Falls back to BETTER_AUTH_SECRET when unset.
PREVIEW_SIGNING_SECRET=

# --- OpenAI (gpt-image-1 door swap + hero re-render) ---
# Unchanged by the migration: the app has always called api.openai.com directly
# with this key. Copy the existing sk-proj-... value over from Vibecode as-is.
OPENAI_API_KEY=
# Override only when routing through a proxy. Defaults to https://api.openai.com/v1
OPENAI_BASE_URL=

# --- Email (Resend) ---
RESEND_API_KEY=
# Inbox that receives new-lead / repair-request alerts.
LEAD_NOTIFICATION_EMAIL=

# --- Square subscriptions (Starter $49 / Growth $99) ---
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- Diagnostics ---
# Gates ?debug=1 and ?debug=images on /api/garage/detect, which return the
# intermediate trace and the gridded source images (the customer's own photo).
# Send it as the x-debug-secret header. Leave BLANK to disable the trace
# entirely — an unset value denies, it does not wave requests through.
# Set the real value in the Render dashboard; never commit one here.
DEBUG_TRACE_SECRET=
